# Salin jadi apps/web/.env.local (jangan di-commit).
# Hanya kunci publik di sini. Secret key TIDAK boleh ada di aplikasi web.

# Sama dengan SUPABASE_URL di .env.local root
NEXT_PUBLIC_SUPABASE_URL=
# Sama dengan SUPABASE_PUBLISHABLE_KEY di .env.local root (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Kata sandi akun demo untuk tes Playwright (sama dengan SEED_PASSWORD)
E2E_PASSWORD=
