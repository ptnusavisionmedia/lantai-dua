    "danger": { "$type": "color", "$value": "#B42318" },
    "danger-soft": { "$type": "color", "$value": "#FBE7E5" },
    "chart": {
      "1": { "$type": "color", "$value": "{color.primary}" },
      "2": { "$type": "color", "$value": "{color.accent}" },
      "3": { "$type": "color", "$value": "#6E8F96" },
      "4": { "$type": "color", "$value": "#C9A88D" },
      "5": { "$type": "color", "$value": "{color.ink-subtle}" }
    }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Archivo", "system-ui", "sans-serif"] },
    "text": { "$type": "fontFamily", "$value": ["Instrument Sans", "system-ui", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["Geist Mono", "ui-monospace", "monospace"] }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "24": { "$type": "dimension", "$value": "96px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "10px" },
