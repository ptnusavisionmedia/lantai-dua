    "primary": { "$type": "color", "$value": "#0E4B57", "$description": "Petrol — Lantai 1: belanja, aksi, fokus" },
    "primary-hover": { "$type": "color", "$value": "#0A3A44" },
    "primary-soft": { "$type": "color", "$value": "#E2EDEE" },
