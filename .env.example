# Salin jadi .env.local (jangan di-commit) lalu isi dari dashboard Supabase project lantai-dua-dev.
# Dipakai skrip (scripts/*.ts) dan tes RLS (packages/db-tests). Web punya file sendiri: apps/web/.env.local.

# Project Settings → General → Project ID
SUPABASE_PROJECT_REF=
# Project Settings → Data API → Project URL, contoh: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Project Settings → API Keys → publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=
# Project Settings → API Keys → secret key (sb_secret_...). JANGAN pernah dipakai di kode web.
SUPABASE_SECRET_KEY=
# Kata sandi untuk 7 akun demo (pemilik@lantaidua.test dst). Minimal 8 karakter.
SEED_PASSWORD=
